generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  emailVerified   DateTime?
  passwordHash    String?
  phone           String?
  profileImage    String?
  role            UserRole @default(USER)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  providerProfile ServiceProvider?
  bookings        Booking[]        @relation("CustomerBookings")
  reviews         Review[]         @relation("CustomerReviews")

  @@index([role])
  @@map("users")
}

model Booking {
  id            String        @id @default(cuid())
  userId        String
  providerId    String
  serviceId     String
  bookingDate   DateTime
  timeSlot      String
  status        BookingStatus @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  completedAt   DateTime?
  customer      User            @relation("CustomerBookings", fields: [userId], references: [id], onDelete: Cascade)
  provider      ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  service       Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  review        Review?

  @@unique([providerId, bookingDate, timeSlot])
  @@unique([userId, providerId, bookingDate, timeSlot])
  @@index([userId, createdAt])
  @@index([providerId, bookingDate])
  @@index([status])
  @@map("bookings")
}

model Review {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  userId     String
  providerId String
  serviceId  String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  booking    Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer   User            @relation("CustomerReviews", fields: [userId], references: [id], onDelete: Cascade)
  provider   ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  service    Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([providerId, createdAt])
  @@index([serviceId, createdAt])
  @@map("reviews")
}

model ServiceCategory {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  icon        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  services    Service[]

  @@map("service_categories")
}

model Service {
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  description      String?
  basePrice        Float
  durationMinutes  Int               @default(120)
  isActive         Boolean           @default(true)
  categoryId       String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  category         ServiceCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  providerServices ProviderService[]
  bookings         Booking[]
  reviews          Review[]

  @@unique([name, categoryId])
  @@index([categoryId])
  @@map("services")
}

model ServiceProvider {
  id                String                 @id @default(cuid())
  userId            String                 @unique
  businessName      String?
  bio               String?
  imageUrl          String?
  addressLine1      String?
  city              String?
  state             String?
  country           String?                @default("USA")
  postalCode        String?
  yearsOfExperience Int?
  approvalStatus    ProviderApprovalStatus @default(PENDING)
  isFeatured        Boolean                @default(false)
  rating            Float                  @default(0)
  totalReviews      Int                    @default(0)
  jobsCompleted     Int                    @default(0)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerServices  ProviderService[]
  availabilitySlots AvailabilitySlot[]
  bookings          Booking[]
  reviews           Review[]

  @@index([approvalStatus, rating, totalReviews])
  @@index([city, state])
  @@map("service_providers")
}

model ProviderService {
  id         String   @id @default(cuid())
  providerId String
  serviceId  String
  isPrimary  Boolean  @default(false)
  customPrice Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  provider   ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  service    Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([providerId, serviceId])
  @@index([serviceId])
  @@index([providerId, isPrimary])
  @@map("provider_services")
}

model AvailabilitySlot {
  id          String   @id @default(cuid())
  providerId  String
  dayOfWeek   Weekday
  timeSlot    String
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  provider    ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, dayOfWeek, timeSlot])
  @@index([providerId, dayOfWeek])
  @@map("availability_slots")
}

enum UserRole {
  ADMIN
  USER
  SERVICE_PROVIDER
}

enum ProviderApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum Weekday {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}
